
import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.pipeline import make_pipeline
from sklearn.metrics import mean_squared_error

np.random.seed(0)

X = np.linspace(0, 1, 30).reshape(-1, 1)
y = np.sin(2 * np.pi * X).ravel() + np.random.normal(0, 0.2, 30)

X_test = np.linspace(0, 1, 100).reshape(-1, 1)
y_test = np.sin(2 * np.pi * X_test).ravel()

degrees = [1, 4, 15]

plt.figure(figsize=(12, 4))

for i, degree in enumerate(degrees, 1):
    model = make_pipeline(
        PolynomialFeatures(degree),
        LinearRegression()
    )

    model.fit(X, y)

    train_pred = model.predict(X)
    test_pred = model.predict(X_test)

    train_error = mean_squared_error(y, train_pred)
    test_error = mean_squared_error(y_test, test_pred)

    plt.subplot(1, 3, i)
    plt.scatter(X, y, color="blue", label="Training Data")
    plt.plot(X_test, y_test, color="green", label="True Curve")
    plt.plot(X_test, test_pred, color="red", label="Prediction")
    plt.title(f"Degree {degree}")
    plt.xlabel("X")
    plt.ylabel("Y")
    plt.legend()

    print(f"Degree: {degree}")
    print(f"Training Error: {train_error:.4f}")
    print(f"Testing Error: {test_error:.4f}")
    print()

plt.tight_layout()
plt.show()

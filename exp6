
import numpy as np
import matplotlib.pyplot as plt
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense
from tensorflow.keras.optimizers import SGD, Adam

np.random.seed(42)
tf.random.set_seed(42)

X = np.linspace(-1, 1, 200).reshape(-1, 1)
y = 3 * X + 2 + np.random.normal(0, 0.2, (200, 1))

optimizers = {
    "Gradient Descent": SGD(learning_rate=0.01, momentum=0.0),
    "SGD": SGD(learning_rate=0.01),
    "Momentum": SGD(learning_rate=0.01, momentum=0.9),
    "Adam": Adam(learning_rate=0.01)
}

histories = {}

for name, optimizer in optimizers.items():
    model = Sequential([
        Dense(16, activation="relu", input_shape=(1,)),
        Dense(1)
    ])

    model.compile(optimizer=optimizer, loss="mse")

    history = model.fit(
        X, y,
        epochs=100,
        batch_size=32,
        verbose=0
    )

    histories[name] = history.history["loss"]

    print(f"{name}: Final Loss = {histories[name][-1]:.4f}")

plt.figure(figsize=(9, 5))

for name, losses in histories.items():
    plt.plot(losses, label=name)

plt.xlabel("Epoch")
plt.ylabel("Mean Squared Error")
plt.title("Optimizer Comparison")
plt.legend()
plt.grid(True)
plt.show()
